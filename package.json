{
  "name": "knights-of-old",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:server": "rolldown server/index.ts --platform node --format esm --file dist-server/index.js --external ws",
    "server": "npm run build:server && node dist-server/index.js",
    "deploy": "node server/deploy.mjs",
    "lab": "vitest run --config vitest.lab.config.ts"
  },
  "dependencies": {
    "@dimforge/rapier2d-deterministic-compat": "^0.21.0",
    "pixi.js": "^8.22.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
